{
  "name": "@openclaw/krillswitch-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "krillswitch": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@napi-rs/keyring --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.js",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@napi-rs/keyring": "1.3.0",
    "@openclaw/krillswitch-core": "workspace:*",
    "clipanion": "3.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "0.28.1",
    "typescript": "~5.9.3",
    "tsx": "4.22.3",
    "vitest": "^4.1.8"
  }
}
