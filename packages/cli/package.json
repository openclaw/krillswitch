{
  "name": "@openclaw/krillswitch-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "krillswitch": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --target=node --external @napi-rs/keyring --outfile=dist/index.js",
    "prepack": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@napi-rs/keyring": "1.3.0",
    "@openclaw/krillswitch-core": "workspace:*",
    "clipanion": "3.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
