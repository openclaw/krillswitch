{
  "name": "@openclaw/krillswitch-core",
  "version": "0.0.1",
  "description": "Pure TypeScript feature-flag evaluator and wire contracts for Krill Switch.",
  "license": "MIT",
  "author": "OpenClaw Team <dev@openclaw.ai>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openclaw/krillswitch.git",
    "directory": "packages/core"
  },
  "homepage": "https://krillswitch.com/core-sdk.html",
  "bugs": {
    "url": "https://github.com/openclaw/krillswitch/issues"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  }
}
