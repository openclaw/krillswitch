{
  "name": "@openclaw/krillswitch-react",
  "version": "0.0.1",
  "description": "Typed React feature-flag hooks with SSR bootstrap support for Krill Switch.",
  "license": "MIT",
  "author": "OpenClaw Team <dev@openclaw.ai>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#evaluation": "./src/evaluation.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "react-server": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "imports": {
      "#evaluation": "./dist/evaluation.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "react-server": "./dist/server.js",
        "import": "./dist/server.js",
        "default": "./dist/server.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openclaw/krillswitch.git",
    "directory": "packages/react"
  },
  "homepage": "https://krillswitch.com/react-sdk.html",
  "bugs": {
    "url": "https://github.com/openclaw/krillswitch/issues"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openclaw/krillswitch-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
