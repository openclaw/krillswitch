{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/migrations/meta",
      "!**/.wrangler",
      "!**/worker-configuration.d.ts",
      "!**/dist",
      "!**/admin/src/index.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  }
}
