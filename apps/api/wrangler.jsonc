{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krillswitch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "krillswitch",
      // Placeholder id: local dev and tests never talk to a remote database.
      // Replaced with the real id when the service first deploys (slice 7).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
