{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krillswitch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  // better-auth imports node:crypto / node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  // 8787 collides with another service on the primary dev machine.
  "dev": {
    "port": 8799
  },
  "assets": {
    "directory": "../admin/dist",
    "not_found_handling": "single-page-application",
    // Assets win by default; these namespaces must reach the Worker.
    "run_worker_first": ["/v1/*", "/api/*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "krillswitch",
      // Placeholder id: local dev and tests never talk to a remote database.
      // Replaced with the real id when the service first deploys (slice 7).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
