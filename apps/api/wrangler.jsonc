{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krillswitch",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  // better-auth imports node:crypto / node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  // 8787 collides with another service on the primary dev machine.
  "dev": {
    "port": 8799
  },
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker applies the production hostname boundary before it serves
    // any dashboard asset, including the single-page application fallback.
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "switch.openclaw.ai",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://switch.openclaw.ai",
    "GITHUB_VIEWER_ORG": "openclaw"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "krillswitch",
      "database_id": "5323631a-67c1-46f5-b412-586ff2ffe3c3",
      "migrations_dir": "migrations"
    }
  ]
}
