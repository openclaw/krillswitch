{
  "name": "@openclaw/krillswitch-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run ensure-dev-vars && bun run db:setup && wrangler dev",
    "db:setup": "wrangler d1 migrations apply krillswitch --local && wrangler d1 execute krillswitch --local --file=./seed/seed.sql",
    "seed:demo": "node seed/demo.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:generate-auth": "better-auth generate --config auth-schema.config.ts --output src/db/authSchema.ts --yes",
    "ensure-dev-vars": "bun -e \"const fs=require('node:fs');if(!fs.existsSync('.dev.vars'))fs.copyFileSync('.dev.vars.example','.dev.vars')\""
  },
  "dependencies": {
    "@openclaw/krillswitch-core": "workspace:*",
    "better-auth": "^1.6.17",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@cloudflare/workers-types": "^4.20260609.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  }
}
