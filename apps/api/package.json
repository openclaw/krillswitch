{
  "name": "@openclaw/krillswitch-api",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm run ensure-dev-vars && pnpm run db:setup && wrangler dev",
    "db:setup": "wrangler d1 migrations apply krillswitch --local && wrangler d1 execute krillswitch --local --file=./seed/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply krillswitch --remote",
    "deploy:worker": "wrangler deploy",
    "deploy:public": "wrangler deploy --config wrangler.public.jsonc",
    "seed:demo": "node seed/demo.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:generate-auth": "pnpm dlx auth@1.6.23 generate --config auth-schema.config.ts --output src/db/authSchema.ts --yes && pnpm --workspace-root exec biome check --write apps/api/src/db/authSchema.ts",
    "ensure-dev-vars": "node -e \"const fs=require('node:fs');if(!fs.existsSync('.dev.vars'))fs.copyFileSync('.dev.vars.example','.dev.vars')\""
  },
  "dependencies": {
    "@openclaw/krillswitch-core": "workspace:*",
    "better-auth": "1.6.26",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.0",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
